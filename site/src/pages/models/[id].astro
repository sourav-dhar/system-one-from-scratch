---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import FactBlock from '../../components/FactBlock.astro';
import ProvTag from '../../components/ProvTag.astro';
import SourceLinks from '../../components/SourceLinks.astro';
import BenchTable from '../../components/BenchTable.astro';
import CorrectionBlock from '../../components/CorrectionBlock.astro';
import { models, registry, type ModelPage, type Provenance, type Source } from '../../lib/data';

export function getStaticPaths() {
  return models.map((m) => ({ params: { id: m.id }, props: { m } }));
}
interface Props { m: ModelPage }
const { m } = Astro.props;
const refs = new Map(m.references.map((r) => [r.key, r]));
const status = registry.find((r) => r.id === m.id)?.status ?? 'draft';
const planned = m.coverage.filter((c) => c.status === 'planned');
const kinds: Provenance[] = ['independent', 'self-reported', 'code', 'ours', 'inferred'];
const title = `${m.name}${m.version ?? ''}`;
const specSources: Source[] = m.spec
  .flatMap((s) => s.sources)
  .filter((s, i, a) => a.findIndex((t) => t.key === s.key && t.at === s.at) === i);
const specKinds = [...new Set(m.spec.map((s) => s.provenance))];
---
<Base title={`${title} · System One, from scratch`} description={m.dek}>
  <section class="mast" aria-labelledby="m-title">
    <div class="mast-frame">
      <div class="eyebrow">{m.eyebrow.map((e) => <span class="label">{e}</span>)}</div>
      <h1 id="m-title">{m.name}{m.version && <span class="ver">{m.version}</span>}</h1>
      <p class="dek">{m.dek}</p>
      <div class="rule-orn" aria-hidden="true">{m.full_name.split(',')[0]}</div>
      <dl class="spec">
        {m.spec.map((s) => (
          <div><dt class="label">{s.label}</dt><dd>{s.value}</dd></div>
        ))}
      </dl>
      <div class="srcline">
        {specKinds.map((p) => <ProvTag kind={p} />)}
        <SourceLinks sources={specSources} refs={refs} />
      </div>
    </div>
    <div class="legend-pv" aria-label="Provenance key">
      <span class="label">Every result and design fact is tagged:</span>
      {kinds.map((k) => <ProvTag kind={k} />)}
    </div>
    {status !== 'published' && (
      <p class="lede" style="margin-top:22px"><strong>Draft page.</strong> {planned.length} elements of the primary sources are assigned to sections that are still being written; the coverage list below shows which.</p>
    )}
  </section>

  <section aria-labelledby="s2">
    <SectionHead no={2} title="Thirty-second summary" id="s2" />
    <div class="summary-grid">
      <article><h3 class="label">What it is</h3>{m.summary.what.map((f) => <FactBlock fact={f} refs={refs} />)}</article>
      <article><h3 class="label">Why it matters</h3>{m.summary.why.map((f) => <FactBlock fact={f} refs={refs} />)}</article>
      <article><h3 class="label">Main weakness</h3>{m.summary.weakness.map((f) => <FactBlock fact={f} refs={refs} />)}</article>
    </div>
  </section>

  {m.benchmarks.map((t, i) => (
    <section aria-labelledby={`s9-${i}`}>
      <SectionHead no={9} title={t.title} id={`s9-${i}`} />
      <BenchTable table={t} refs={refs} />
      {i === m.benchmarks.length - 1 && m.corrections.map((c) => <CorrectionBlock c={c} refs={refs} />)}
    </section>
  ))}

  <section aria-labelledby="s12">
    <SectionHead no={12} title="Coverage of the primary sources" id="s12" />
    <p class="lede">Every element the code, model card or evaluations describe, and the section of this page that explains it.</p>
    <div class="tbl-scroll" role="region" aria-label="Coverage list, scrollable" tabindex="0">
      <table class="coverage">
        <thead><tr><th scope="col">Element</th><th scope="col">Section</th><th scope="col">Status</th><th scope="col">Source</th></tr></thead>
        <tbody>
          {m.coverage.map((c) => (
            <tr>
              <td>{c.element}</td>
              <td>{c.section ?? c.reason}</td>
              <td><span class={`status status-${c.status === 'n/a' ? 'na' : c.status}`}>{c.status}</span></td>
              <td><span class="srcline" style="margin:0"><SourceLinks sources={[c.source]} refs={refs} /></span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="s13">
    <SectionHead no={13} title="Sources and verification" id="s13" />
    <ul class="refs">
      {m.references.map((r) => (
        <li><code>{r.key.replace(/^repo:/, '')}</code> <a href={r.url}>{r.title}</a></li>
      ))}
    </ul>
    <h3 class="label" style="margin-top:26px">Claims ledger</h3>
    <ul class="notes">
      {m.claims.map((c) => (
        <li>{c.text}<div class="srcline"><span class="pv pv-code">verified: {c.verified_by}, {c.date}</span><SourceLinks sources={c.sources} refs={refs} /></div></li>
      ))}
    </ul>
  </section>
</Base>
