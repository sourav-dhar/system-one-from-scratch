---
import Base from '../layouts/Base.astro';
import { registry, FAMILY_LABEL, href } from '../lib/data';

const tiers = [
  { tier: 'A', title: 'Tier A', note: 'deep pages: architecture, training, data, benchmarks, try it' },
  { tier: 'B', title: 'Tier B', note: 'structure and key facts' },
  { tier: 'C', title: 'Tier C', note: 'reference cards' },
] as const;
const counted = registry.filter((s) => s.family !== 'ours').length;
---
<Base title="System One, from scratch" description="How System One decision models are built, trained and measured, with every number tied to its source." current="home">
  <section class="hero" aria-labelledby="h">
    <p class="label">Companion to the System One research repository</p>
    <h1 id="h">How System&nbsp;One models are built, trained and measured</h1>
    <p>System One models answer typed questions about some state (yes or no, choose one of several options, score on a scale) with probabilities rather than generated text. The deep pages here take one model apart from first principles, and every number on them is tied to its source.</p>
    <div class="paths">
      <div>
        <h2 class="label">New to System One</h2>
        <p>Start with the <a href={href('models/clm/')}>CLM page</a>, then the <a href="https://github.com/sourav-dhar/system-one-from-scratch/blob/main/docs/research/README.md">start-here research guide</a>.</p>
      </div>
      <div>
        <h2 class="label">Building one</h2>
        <p>Each deep page states what is frozen, what is trained and what is cached, and links the code where it is public.</p>
      </div>
      <div>
        <h2 class="label">Checking the evidence</h2>
        <p>Every result is tagged by where it comes from (an independent measurement, the authors' own result, published code, our run or our inference) and links to its source.</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="idx">
    <div class="sec-head"><span class="no" data-roman="I">§1</span><h2 id="idx">Models</h2></div>
    <p class="lede">{counted} entries from our research notes, plus our own model in development. Most are System One decision models; the reference cards also cover hosted decision APIs, whose architecture is undisclosed, and Inkling, a family of general-purpose LLMs rather than decision models. Pages are being written one at a time; names without a link are on the way.</p>
    {tiers.map(({ tier, title, note }) => (
      <div class="tier">
        <h3><span class="nw">{title}</span> <span class="label">{note}</span></h3>
        <ul class="syslist">
          {registry.filter((s) => s.tier === tier).map((s) => (
            <li>
              {s.has_page ? <a class="nm" href={href(`models/${s.id}/`)}>{s.name}</a> : <span class="nm soon">{s.name}</span>}
              <span class="fam">{FAMILY_LABEL[s.family] ?? s.family}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Base>
