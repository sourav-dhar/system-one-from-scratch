---
import { roman } from '../lib/data';
import Figures from './Figures.astro';
interface Props { no: number; title: string; id: string }
const { no, title, id } = Astro.props;
---
<div class="sec-head"><span class="no" data-roman={roman(no)}>§{no}</span><h2 id={id}><Figures text={title} /></h2></div>
